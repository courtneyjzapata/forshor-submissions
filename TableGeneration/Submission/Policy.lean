def handles (mode : ProductMode) (k : Nat) : Bool :=
  decide ((mode = .PhaseProduct ∧ k = 4) ∨
    (mode = .PhaseProduct ∧ k = 5) ∨
    (mode = .PhaseProduct ∧ k = 6) ∨
    (mode = .PhaseTripleProduct ∧ k = 5) ∨
    (mode = .PhaseTripleProduct ∧ k = 7) ∨
    (mode = .PhaseTripleProduct ∧ k = 6))

def generatedPoints (mode : ProductMode) (k : Nat) : List Point :=
  if decide (mode = .PhaseProduct ∧ k = 4) then ptsPP4
  else if decide (mode = .PhaseProduct ∧ k = 5) then ptsPP5
  else if decide (mode = .PhaseProduct ∧ k = 6) then ptsPP6
  else if decide (mode = .PhaseTripleProduct ∧ k = 5) then ptsPTP5
  else if decide (mode = .PhaseTripleProduct ∧ k = 7) then ptsPTP7
  else if decide (mode = .PhaseTripleProduct ∧ k = 6) then ptsPTP6
  else canonicalPoints mode k

def generatePointsInOrder (mode : ProductMode) (k : Nat) (_hk : k >= 2) : List Point :=
  generatedPoints mode k

def generate (mode : ProductMode) (k : Nat) (hk : k >= 2) : Prog k :=
  if h0 : (mode = .PhaseProduct ∧ k = 4) then h0.2.symm ▸ progPP4
  else if h1 : (mode = .PhaseProduct ∧ k = 5) then h1.2.symm ▸ progPP5
  else if h2 : (mode = .PhaseProduct ∧ k = 6) then h2.2.symm ▸ progPP6
  else if h3 : (mode = .PhaseTripleProduct ∧ k = 5) then h3.2.symm ▸ progPTP5
  else if h4 : (mode = .PhaseTripleProduct ∧ k = 7) then h4.2.symm ▸ progPTP7
  else if h5 : (mode = .PhaseTripleProduct ∧ k = 6) then h5.2.symm ▸ progPTP6
  else baselineGenerate mode k hk

theorem generatedPoints_valid
    (mode : ProductMode) (k : Nat) (_hk : k >= 2)
    (hhandles : handles mode k = true) :
    ValidPointList mode k (generatedPoints mode k) := by
  rcases of_decide_eq_true hhandles with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · unfold ValidPointList; decide
  · unfold ValidPointList; decide
  · unfold ValidPointList; decide
  · unfold ValidPointList; decide
  · unfold ValidPointList; decide
  · unfold ValidPointList; decide

theorem generate_safe
    (mode : ProductMode) (k : Nat) (hk : k >= 2)
    (hhandles : handles mode k = true) :
    ValidPointOrder (generatedPoints mode k) (generatePointsInOrder mode k hk) /\
      ProgConsumesPtsSafe (positive_of_ge_two hk) State.start_state
        (generate mode k hk) (generatePointsInOrder mode k hk) := by
  rcases of_decide_eq_true hhandles with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · have hhk : hk = (by decide : 4 >= 2) := Subsingleton.elim _ _
    subst hk
    constructor
    · exact List.Perm.refl _
    · apply progConsumesPtsSafe_of_checks <;> decide
  · have hhk : hk = (by decide : 5 >= 2) := Subsingleton.elim _ _
    subst hk
    constructor
    · exact List.Perm.refl _
    · apply progConsumesPtsSafe_of_checks <;> decide
  · have hhk : hk = (by decide : 6 >= 2) := Subsingleton.elim _ _
    subst hk
    constructor
    · exact List.Perm.refl _
    · apply progConsumesPtsSafe_of_checks <;> decide
  · have hhk : hk = (by decide : 5 >= 2) := Subsingleton.elim _ _
    subst hk
    constructor
    · exact List.Perm.refl _
    · apply progConsumesPtsSafe_of_checks <;> decide
  · have hhk : hk = (by decide : 7 >= 2) := Subsingleton.elim _ _
    subst hk
    constructor
    · exact List.Perm.refl _
    · apply progConsumesPtsSafe_of_checks <;> decide
  · have hhk : hk = (by decide : 6 >= 2) := Subsingleton.elim _ _
    subst hk
    constructor
    · exact List.Perm.refl _
    · apply progConsumesPtsSafe_of_checks <;> decide

